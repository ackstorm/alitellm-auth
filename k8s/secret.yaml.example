# Create the real secret with:
#
#   kubectl create secret generic alitellm-auth-secret -n test \
#     --from-literal=SESSION_SECRET_KEY=$(openssl rand -hex 32) \
#     --from-literal=OAUTH_CLIENT_SECRET=<value-of-GENAI_OAUTH_MCP_SECRET-in-dex> \
#     --from-literal=LITELLM_MASTER_KEY=sk-admin-...
#
# DO NOT commit the real values — this file is reference only.
#
apiVersion: v1
kind: Secret
metadata:
  name: alitellm-auth-secret
  namespace: test
type: Opaque
stringData:
  # Shared across all replicas — run: openssl rand -hex 32
  SESSION_SECRET_KEY: "change-me"

  # OIDC client secret — matches ${GENAI_OAUTH_MCP_SECRET} in Dex staticClients, or client credentials in Keycloak
  OAUTH_CLIENT_SECRET: "change-me"

  # LiteLLM master key (used to call /team/new and /key/generate)
  LITELLM_MASTER_KEY: "sk-admin-change-me"
