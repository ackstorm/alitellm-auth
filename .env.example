# Application
APP_BASE_URL=http://localhost:8080
SESSION_SECRET_KEY=change-me-to-32-random-chars

# OIDC Provider (Dex, Keycloak, etc.) — external URL reachable from browser AND API server
OAUTH_ISSUER_URL=https://dex.yourdomain.com/dex
OAUTH_CLIENT_ID=platform
OAUTH_CLIENT_SECRET=change-me

# LiteLLM — external URL reachable from API server
LITELLM_URL=https://litellm.yourdomain.com
LITELLM_MASTER_KEY=sk-admin-change-me
