# Dev/CI toolchain image — every Makefile target runs inside this.
# Content-addressed by its own sha256 (see scripts/dev.sh). No host pip/venv.
FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    UV_SYSTEM_PYTHON=1 \
    UV_LINK_MODE=copy

# OS tools: make (target runner inside container), git (version/changelog ops).
# Node 22 LTS from NodeSource so `make build-ui`/`dev-ui` run in-container (BUILD-01),
# aligned with the Dockerfile `ui-builder` stage (node:22-slim). curl is needed for
# the NodeSource setup script and is removed afterward to keep the image lean.
RUN apt-get update -qq \
 && apt-get install -y --no-install-recommends make git ca-certificates curl \
 && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
 && apt-get install -y --no-install-recommends nodejs \
 && npm --version \
 && apt-get purge -y curl \
 && apt-get autoremove -y \
 && rm -rf /var/lib/apt/lists/*

# uv first, then the Python toolchain (lint, test, docs)
RUN pip install --no-cache-dir uv \
 && uv pip install --system --no-cache-dir \
      ruff==0.8.4 \
      pytest==8.3.4 \
      pytest-asyncio==0.24.0 \
      pytest-cov==6.0.0 \
      respx==0.21.1 \
      mkdocs-material==9.5.49 \
      mike==2.1.3

WORKDIR /app
# Project runtime deps are installed at run time from pyproject (editable),
# so a dependency bump doesn't require rebuilding this image.
CMD ["bash"]
